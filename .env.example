# Required
OPENROUTER_API_KEY=
SARVAM_API_KEY=

# Optional model overrides (OpenRouter ids). Defaults shown.
# DOODO_TEACHER_MODEL=google/gemini-3.7-flash
# DOODO_TEACHER_FALLBACKS=google/gemini-3.8-flash,anthropic/claude-sonnet-5.5
# DOODO_DEEP_MODEL=openai/gpt-5.5
# DOODO_DEEP_FALLBACKS=anthropic/claude-sonnet-5.5,google/gemini-3.7-flash
# DOODO_VISION_MODEL=google/gemini-3.8-flash
# DOODO_VISION_FALLBACKS=google/gemini-3.7-flash

# Optional voice settings (Sarvam)
# DOODO_TTS_MODEL=bulbul:v3
# DOODO_TTS_SPEAKER=shubh
# DOODO_TTS_PACE=1.05
# DOODO_STT_MODEL=saaras:v3

# Sent to OpenRouter as HTTP-Referer
# DOODO_APP_URL=http://localhost:3000
